# Exporter
EXPORTER_PORT=8000
SYS_EXP_LOG_LEVEL=INFO

# Prometheus
PROMETHEUS_PORT=9090

# Alertmanager
ALERTMANAGER_PORT=9093

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Required — docker-compose.yml refuses to start without this set.
GRAFANA_ADMIN_PASSWORD=change-this-to-a-strong-password
